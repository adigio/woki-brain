{
    "extends": "@tsconfig/node24/tsconfig.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "rootDir": "src",
        "outDir": "dist",
        "sourceMap": true
    },
    "include": [
        "src/**/*",
        "resources/**/*"
    ]
}